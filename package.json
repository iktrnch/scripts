{
	"name": "iktrnch-scripts",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"assets": "node tools/static-assets.mjs",
		"assets:build": "node tools/static-assets.mjs --clean-build",
		"predev": "bun run assets",
		"dev": "vite dev",
		"prebuild": "bun run assets:build",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --test-isolation=none tools/*.test.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "bun run assets",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"marked": "^18.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sanitize-html": "^2.18.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
